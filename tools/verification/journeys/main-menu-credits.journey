# Review credits opening, the first page, cancellation and reopening.
start main-menu
until settled
click "TextButton Credits"
wait 180
capture main-menu-credits-first-page
key ESCAPE
wait 30
capture main-menu-credits-closed
click "TextButton Credits"
wait 180
capture main-menu-credits-reopened
click "close credits"
wait 30
capture main-menu-credits-returned
