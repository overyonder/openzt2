# The profile dialog lists profiles and the options screen shows its resolution list (#187).
phase splash
wait 300
click "splashbutton0"
phase main-menu
wait 120
click "profile_manager_opener"
wait 180
expect-visible "profile_manager_dialog"
expect-rows "profilelist" >= 1         # the run starts with the default profile
capture profile-dialog
key ESCAPE
wait 60
click "Game Options Button"
wait 180
capture options                        # headless runs have no monitor, so resolution rows may be empty
