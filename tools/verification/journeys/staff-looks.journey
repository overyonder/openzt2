# Hired staff draw distinct authored looks: body sex, head and uniform textures (#172).
include boot-to-freeform-map.steps
move 800 400
wheel 1 14
wait 60
click "staff"
wait 60
click "icon" 1                  # the first row starts selected and ignores clicks (#184)
click "icon" 0                  # educator, the first hireable role; reselected after each hire
move 700 300
wait 60
capture placement-preview
click 700 300
wait 60
click "icon" 0
move 800 300
wait 60
click 800 300
wait 60
click "icon" 0
move 900 300
wait 60
click 900 300
wait 60
click "icon" 0
move 700 420
wait 60
click 700 420
wait 60
click "icon" 0
move 800 420
wait 60
click 800 420
wait 60
click "icon" 0
move 900 420
wait 60
click 900 420
wait 60
expect staff == 6
key ESCAPE
wait 30
capture hired-staff
wait 600
capture hired-staff-later
