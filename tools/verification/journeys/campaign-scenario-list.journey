# Campaign metadata, native rows, selection and the requested map (#52).
start main-menu
click "Campaign Game Button"
phase map-selection
until rows "Campaign List" >= 1
until rows "Campaign Scenario List" >= 1
capture campaign-screen
click-row "Campaign List" 1
until text "node-0" "African Adventure Tutorial"
capture second-campaign
expect-rows "Campaign Scenario List" == 1
expect-text "Map Name Label" "Jeep® Vehicles"
click-row "Campaign List" 0
until rows "Campaign Scenario List" == 3
expect-text "node-0" "Zoo Tycoon 2 Tutorials"
click-row "Campaign Scenario List" 2
until text "Map Name Label" "Tutorial 3: Getting Information"
capture selected-campaign-scenario
click "Play Map"
phase in-game
expect-campaign-world Tutorial3 tutorialscen3
capture campaign-map-started

# Game Options' Exit Game opens its save/exit confirmation; cancel keeps playing.
key ESCAPE
until visible "In Game Options" within 300
move "TextButton Exit Hover"
until visible "TextButton Exit" within 120
click "TextButton Exit"
until visible "Exit Game layout" within 300
capture exit-game-dialog
click "cancel"
until hidden "Exit Game layout" within 120

# Return to the start screen after checking the distinct tutorial world.
return-to-menu
until visible "Campaign Game Button"
