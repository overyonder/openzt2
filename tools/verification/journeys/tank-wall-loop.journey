# #124: a closed loop of one tank wall type becomes a tank, whose walls
# the tank tools raise and lower.
start freeform-map
click "construction"
click "Tank Tools Tab"
select-catalogue "tankseg_mm"
snapshot tank-start
click 1000 220
click 1350 220
until fences > @tank-start
snapshot tank-step
click 1350 470
until fences > @tank-step
snapshot tank-step
click 1000 470
until fences > @tank-step
snapshot tank-step
click 1000 220                  # close the loop
until fences > @tank-step
key ESCAPE
until placement_previews == 0
until tanks == 1 within 600
wait 30
capture tank-built
snapshot tank-before-raise
click "raise wall"
drag 1180 340 1180 300
until tank_wall_height_m > @tank-before-raise within 600
wait 30
capture wall-raised
snapshot tank-raised
click "lower wall"
drag 1180 340 1180 380
until tank_wall_height_m < @tank-raised within 600
