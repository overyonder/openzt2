if [[ ${OPENZT2_RELEASE_HOST:-0} == 1 ]]; then
  # Native packaging hosts use platform SDKs; Nix-linked Linux binaries cannot
  # be installed on ordinary Debian systems. CI installs the flake's Rust pin.
  : "${OPENZT2_NATIVE_DEPENDENCY_DIR:?Release native dependencies are required}"
  export MOJOSHADER_DIR="$OPENZT2_NATIVE_DEPENDENCY_DIR/include"
  export PKG_CONFIG_PATH="$OPENZT2_NATIVE_DEPENDENCY_DIR/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  export LIBRARY_PATH="$OPENZT2_NATIVE_DEPENDENCY_DIR/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
  export LD_LIBRARY_PATH="$OPENZT2_NATIVE_DEPENDENCY_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
  watch_file patches/mojoshader/*.patch patches/vkd3d/*.patch patches/gamescope/*.patch
  if [[ ${OPENZT2_WINDOWS_CROSS:-0} == 1 ]]; then
    use flake .#windows
  else
    use flake
  fi
fi

if [[ ${NIX_DIRENV_DID_FALLBACK:-0} == 1 ]]; then
  echo "OpenZT2 requires the current flake environment; refusing stale fallback." >&2
  return 1
fi

: "${KAI_CARGO_TARGET_ROOT:?KAI_CARGO_TARGET_ROOT must be set}"
export CARGO_TARGET_DIR="$KAI_CARGO_TARGET_ROOT/openzt2-reimplementation"
