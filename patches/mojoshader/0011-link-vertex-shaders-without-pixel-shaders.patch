  * Call this to patch SPIR-V output returned from MOJOSHADER_parse to correctly
  *  interpret vertex input and link vertex shader output to pixel shader input.
  *
+ * A NULL pixel shader assigns consecutive locations to non-builtin vertex
+ *  outputs for consumers such as a fixed-function fragment implementation.
+ *
  * On success, this returns the size of the shaders' internal "patch table",
  *  which should be subtracted from the parseData's output_len when passing the
  *  final SPIR-V to your shader compiler.
--- a/mojoshader.c
+++ b/mojoshader.c
@@ -4023,6 +4023,24 @@
 #include <spirv/spirv.h> /* SpvOp, SpvOpConvertUToF, SpvOpConvertSToF, SpvOpCopyObject */
 #endif
 
+int MOJOSHADER_spirvVertexOutputLocation(const MOJOSHADER_parseData *spirv,
+                                        MOJOSHADER_usage usage, int index)
+{
+#if SUPPORT_PROFILE_SPIRV
+    if (spirv && spirv->shader_type == MOJOSHADER_TYPE_VERTEX
+     && spirv->output_len >= (int) sizeof(SpirvPatchTable)
+     && usage >= 0 && usage < MOJOSHADER_USAGE_TOTAL && index >= 0 && index < 16)
+    {
+        const int length = spirv->output_len - sizeof(SpirvPatchTable);
+        const SpirvPatchTable *table = (const SpirvPatchTable *) &spirv->output[length];
+        const uint32 offset = table->attrib_offsets[usage][index];
+        if (offset && offset < (uint32) length / sizeof(uint32))
+            return (int) ((const uint32 *) spirv->output)[offset];
+    }
+#endif
+    return -1;
+}
